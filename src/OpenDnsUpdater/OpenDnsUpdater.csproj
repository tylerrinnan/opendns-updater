<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenDnsUpdater</AssemblyName>
    <RootNamespace>OpenDnsUpdater</RootNamespace>
    <Product>OpenDNS Updater</Product>
    <Description>Lightweight tray utility that keeps your OpenDNS network IP current so filtering follows your real public IP.</Description>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
  </ItemGroup>

</Project>
